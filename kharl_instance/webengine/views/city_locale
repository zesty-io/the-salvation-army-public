<div class="d-flex flex-column justify-content-center my-5">
    <h1 class="text-center fs-1 fw-bold mb-5">Locations</h1>
    <div class="list-group container">
       {{each {location_properties} as location sort by name ASC where find_in_set('{page.zuid}', locale_city ) }}
                <ul class="list-group">
                    <li class="list-group-item"> 
                       {{location.name}}
                    </li>
                </ul>
        {{/each}}
    </div>
</div>