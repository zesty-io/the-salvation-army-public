	</div>
	<hero-module
  title="Annual Reports"
  imageUrl="https://mgfrnv8q.media.zestyio.com/Vector.png"
  subtitle="[FPO]  Learn about the Salvation Army’s annual impact"
  lightMode="true"
>
  <div
    slot="cta"
    class="cta"
  >
    <div class="cta__secondary">
      <button
        type="button"
        class="btn btn--small btn--dark--fill"
      >
        Annual Reports
      </button>

    </div>
  </div>
</hero-module>
	<hero-module
  title="Tell Us A Story"
  imageUrl="https://mgfrnv8q.media.zestyio.com/Vector.png"
  subtitle="Have you seen the transforming power of The Salvation Army at work in your community? We want to hear – and share – your story"
>
  <div
    slot="cta"
    class="cta"
  >
    <div class="cta__secondary">
      <button
        type="button"
        class="btn btn--small btn--dark--fill"
      >
        Share a Story
      </button>
    </div>
  </div>
</hero-module>
	<div class="row" style="background-color:#EFF1F0;" classname="{styles.pvlRow}">
		<div class="row" style="block" className={styles.pvlColumn}>
			<tsa-hero-text heading="PR Contact">
      <p>John Smith</p>
      <p>John.Smith@usc.salvationarmy.org</p>
      <p>(123) 456-7890</p>
    </tsa-hero-text>
		</div>
	</div>
